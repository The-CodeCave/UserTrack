    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.2"
