    "packages:typecheck": "pnpm -r --filter \"./packages/**\" typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
