{
  "name": "usertrack-waitlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3101",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3101",
    "start": "serve -s dist -l ${PORT:-3101}",
