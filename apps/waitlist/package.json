    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "convex": "^1.45.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
