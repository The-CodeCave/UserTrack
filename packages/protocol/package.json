{
  "name": "@usertrack/protocol",
  "version": "0.1.0",
  "description": "UserTrack native integration protocol (v1): HMAC-SHA256 request/response signing, nonce cache, wire types. WebCrypto only, zero dependencies.",
  "keywords": ["usertrack", "protocol", "hmac", "analytics", "growth", "saas"],
  "license": "MIT",
  "homepage": "https://usertrack.dev/developers/integrations/native",
  "bugs": "https://github.com/The-CodeCave/UserTrack/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-CodeCave/UserTrack.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md", "AGENTS.md", "llms.txt"],
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "pack:check": "pnpm pack --pack-destination /tmp && tar -tzf /tmp/usertrack-protocol-*.tgz"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
