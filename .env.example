# Convex (from `npx convex dev` / Convex dashboard)
CONVEX_DEPLOYMENT=dev:xxx
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://xxx.convex.site

# Public URL of this Next.js app (used for metadata, OG, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted Rybbit analytics (cookieless). Empty NEXT_PUBLIC_RYBBIT_SITE_ID disables the script and the server-side events.
# Unset, the production site id is only assumed for a production build whose NEXT_PUBLIC_SITE_URL starts with
# https://usertrack.dev — dev, CI and preview deployments stay silent. Set it explicitly on the Railway prod service.
# NEXT_PUBLIC_RYBBIT_HOST=https://rybbit.internal.thecodecave.de
# NEXT_PUBLIC_RYBBIT_SITE_ID=753f44fa9c50
# RYBBIT_API_KEY=rb_xxx        # optional: server-side /api/track events bypass bot detection + domain validation (Rybbit → site settings → API keys)

# Error tracking (Sentry, EU). Without a DSN the SDK is never initialised and never downloaded.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oyyy.ingest.de.sentry.io/zzz
# SENTRY_ORG=the-codecave           # only needed where source maps are uploaded (CI)
# SENTRY_PROJECT=usertrack
# SENTRY_AUTH_TOKEN=sntrys_xxx      # set → the build uploads source maps; unset → it never talks to Sentry
# NEXT_PUBLIC_APP_VERSION=          # optional release name for /api/health and Sentry (default: RAILWAY_GIT_COMMIT_SHA, then "dev")

# Production only: lets `npx convex deploy` target the prod deployment
# CONVEX_DEPLOY_KEY=prod:xxx

# Shared gateway secret: identical value in this file (Next.js) AND on the Convex deployment. Required — the gateway
# fails closed without it (`SECRET=$(openssl rand -hex 32); echo "UT_GATEWAY_SECRET=$SECRET" >> .env.local; npx convex env set UT_GATEWAY_SECRET "$SECRET"`).
# UT_GATEWAY_SECRET=<openssl rand -hex 32>

# --- Convex deployment env (set with `npx convex env set [--prod]`) ---
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# SITE_URL=https://usertrack.dev            # app URL; every email link is built from it
# Google sign-in (Google Cloud Console → OAuth client, see HUMAN_TODO.md)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# GitHub sign-in (GitHub OAuth App, callback <SITE_URL>/api/auth/callback/github). Missing → button disabled.
# GITHUB_CLIENT_ID=Iv1.xxx
# GITHUB_CLIENT_SECRET=xxx
# "Import from TrustMRR" (operator key from trustmrr.com/dashboard-dev; founders never enter one). Missing → import disabled.
# TRUSTMRR_API_KEY=fixture serves the built-in example response offline (dev / screenshots only).
# TRUSTMRR_API_KEY=tmrr_xxx
# "Continue with X" reuses X_CLIENT_ID / X_CLIENT_SECRET (the Connect X app; add callback <SITE_URL>/api/auth/callback/twitter to it).
# Email (Resend). Without RESEND_API_KEY nothing is sent; every attempt is still logged in `emailEvents`.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="UserTrack <noreply@mail.usertrack.dev>"
# EMAIL_REPLY_TO=hello@usertrack.dev
# FEEDBACK_EMAIL=jovanovic@thecodecave.de   # where the in-app feedback FAB sends its alerts (default: EMAIL_REPLY_TO)
# EMAIL_TOKEN_SECRET=<openssl rand -base64 32>   # signs preference / unsubscribe links (falls back to BETTER_AUTH_SECRET)
# RESEND_WEBHOOK_SECRET=whsec_xxx               # Resend → <convex site url>/webhooks/resend
# Rybbit events from Convex actions (webhook_delivered, sync_completed) — opt-in per deployment
# RYBBIT_SITE_ID=753f44fa9c50
# RYBBIT_HOST=https://rybbit.internal.thecodecave.de
# RYBBIT_API_KEY=rb_xxx
