# Convex (from `npx convex dev` / Convex dashboard)
CONVEX_DEPLOYMENT=dev:xxx
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://xxx.convex.site

# Public URL of this Next.js app (used for metadata, OG, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production only: lets `npx convex deploy` target the prod deployment
# CONVEX_DEPLOY_KEY=prod:xxx

# --- Convex deployment env (set with `npx convex env set [--prod]`) ---
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# SITE_URL=https://usertrack.dev            # app URL; every email link is built from it
# Google sign-in (Google Cloud Console → OAuth client, see HUMAN_TODO.md)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# Email (Resend). Without RESEND_API_KEY nothing is sent; every attempt is still logged in `emailEvents`.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="UserTrack <noreply@mail.usertrack.dev>"
# EMAIL_REPLY_TO=hello@usertrack.dev
# EMAIL_TOKEN_SECRET=<openssl rand -base64 32>   # signs preference / unsubscribe links (falls back to BETTER_AUTH_SECRET)
# RESEND_WEBHOOK_SECRET=whsec_xxx               # Resend → <convex site url>/webhooks/resend
